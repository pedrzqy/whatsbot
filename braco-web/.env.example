# ============================================================
# BRAÇO — opera o chat web da Taobao (Playwright)
#
# Roda como serviço SEPARADO no Easypanel, mesmo projeto do whatsbot.
# No Easypanel isto vai em Environment, não em arquivo.
# ============================================================

# Endereço do whatsbot pela rede interna do Docker. As rotas /ponte/braco/*
# NUNCA precisam ficar expostas na internet — a chave vira segunda camada,
# não a única.
#
# Se der "connect ECONNREFUSED" na subida, o whatsbot escuta noutra porta:
# confere a variável PORT dele (padrão do código é 3000) e ajusta aqui.
# Como último recurso, a URL pública também funciona:
#   https://phazegameswhats-whatsbot.oyyngr.easypanel.host
BOT_URL=http://phazegameswhats_whatsbot:80

# A MESMA chave que está em PONTE_BRACO_KEY no whatsbot.
PONTE_BRACO_KEY=

# Chat web do Wangwang. A conversa precisa JÁ existir (criada pelo app/PC).
TAOBAO_CHAT_URL=https://market.m.taobao.com/app/im/chat/index.html?#/

# Porta de entrada do reinício da tela: o braço abre ESTA página primeiro e só
# então clica no atalho do chat. Sair do domínio e voltar é o que garante que a
# página recarregue de verdade — goto() para a url do chat, estando nela, só
# troca o fragmento e a SPA não recarrega nada.
TAOBAO_HOME_URL=https://www.taobao.com/

# UA do SEU Chrome real (F12 > Console > navigator.userAgent).
# Vazio usa Chrome 151 no Windows, que é o que a sua conta já viu.
CHROME_USER_AGENT=

# Proxy residencial, se um dia contratar. Vazio = sai pelo IP da VPS.
PROXY_URL=

# Intervalo entre varreduras do chat, em segundos (sorteado na faixa).
# Ler de 5 em 5s é comportamento de bot e não ganha nada: o fornecedor
# responde em minutos, não em segundos.
LER_MIN_SEG=50
LER_MAX_SEG=110

# Teto local de envios por hora. O whatsbot já limita; esta é a segunda trava,
# para o caso de o braço entrar em laço por bug.
ENVIO_POR_HORA=10
