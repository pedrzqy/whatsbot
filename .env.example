# ATENCAO: quase tudo que liga e desliga funcao aqui tambem se controla pelo
# WhatsApp, com o comando #admin -- e la vale NA HORA, sem deploy. O valor
# escolhido pelo #admin VENCE o que estiver escrito aqui; o valor aqui e o
# padrao de fabrica, usado enquanto ninguem tiver mexido pelo #admin.
#
# Manda #admin no WhatsApp para ver a lista.

# ─── Servidor do bot ───────────────────────────────────────────────
PORT=3000

# ─── Evolution API (gateway do WhatsApp) ───────────────────────────
# URL onde a Evolution API está rodando (no Square Cloud ou VPS)
EVOLUTION_API_URL=http://localhost:8080
# Chave global de autenticação definida na Evolution API (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=troque-esta-chave
# Nome da instância criada na Evolution API (o "número" conectado)
EVOLUTION_INSTANCE=whatsbot

# ─── Nerix (plataforma de vendas) ──────────────────────────────────
NERIX_API_URL=https://api.nerix.com.br/api/public
# Sua chave privada da Nerix. NUNCA comite este valor.
# (a chave que você compartilhou deve ser rotacionada no painel)
NERIX_API_KEY=coloque-sua-nova-chave-aqui

# ─── O cérebro do atendimento: Claude (camada 1) ───────────────────
# Sem esta chave o bot NÃO quebra: ele segue na cascata abaixo, que é a
# camada 2. É assim que se desliga o Claude sem deploy — apaga a chave.
ANTHROPIC_API_KEY=

# Liga a IA como caminho principal do atendimento. Com false (o padrão),
# quem responde é o menu numerado e nada disto é usado.
# Reverter é trocar para false no painel, sem deploy.
BOT_IA=false

# Nomes com prefixo BOT_ de propósito: CLAUDE_EFFORT e afins já existem em
# ambientes de ferramentas de desenvolvimento, e um nome genérico faria a
# configuração da máquina de alguém mandar no comportamento do bot.
# BOT_CLAUDE_MODELO=claude-opus-5
# Esforço de raciocínio: low basta para atendimento de loja, que é conversa
# curta com fatos vindos de ferramenta. Subir isto sobe a conta.
# BOT_CLAUDE_ESFORCO=low
# Teto de tokens da resposta. NÃO baixe de 2000: o raciocínio do modelo conta
# aqui dentro, e com pouco a resposta ao cliente chega cortada no meio.
# BOT_CLAUDE_MAX_TOKENS=2000
# Freio de emergência da fatura. Passou disto num dia, cai na cascata (que já
# está paga) e avisa no log. O uso normal é ~150/dia.
# BOT_CLAUDE_MAX_DIA=400

# Prazo TOTAL para a IA responder, em ms, contando todas as camadas e as idas
# e vindas de ferramenta. Estourado, o cliente recebe o menu na hora.
# LLM_DEADLINE_MS=25000

# ─── Audio do cliente vira texto ──────────────────────
# Usa a MESMA chave da Groq que ja esta na cascata abaixo -- nao precisa de
# conta nova. Sem chave nenhuma, o cliente que manda audio recebe um pedido
# educado para escrever, em vez de falar com uma parede.
# TRANSCRICAO_API_KEY=          # em branco = usa a GROQ_FALLBACK_API_KEY
# TRANSCRICAO_MODELO=whisper-large-v3-turbo

# ─── LLM: COMBO em cascata (camada 2, a rede) ──────────────────────
# Ordem: Gemini → Cerebras → Groq → Mistral → Cohere → OpenRouter.
# Só entram os que tiverem chave. Se um trava, cai automaticamente no próximo.
# 1) Gemini (primário — melhor qualidade). GROQ_API_KEY aceito por compatibilidade.
GEMINI_API_KEY=coloque-sua-chave-gemini
# GEMINI_MODEL=gemini-flash-latest
# 2) Cerebras (ultrarrápido)
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# 3) Groq (rápido). FALLBACK_API_KEY aceito por compatibilidade.
GROQ_FALLBACK_API_KEY=
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# 4) Mistral
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# 5) Cohere
COHERE_API_KEY=
# COHERE_MODEL=command-r-08-2024
# 6) OpenRouter (rede de segurança — agrega modelos grátis)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=tencent/hy3:free
# Comuns a todos:
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=600
LLM_MAX_HISTORY=4

# ─── O analista (#analisar) ──────────────────────────
# Le o registro, agrupa o que ainda cai no seu colo e PROPOE respostas prontas
# novas -- num arquivo, para voce ler. Nada do que ele escreve entra em uso: a
# linha so vale quando alguem a escreve no src/ponte/repertorio.js de proposito.
# Quantas vezes um assunto precisa se repetir para virar proposta.
# HERMES_MINIMO=2

# ─── Depois da entrega ──────────────────────────────
# Perguntar se a ativacao deu certo, algumas horas depois de entregar a chave.
# LIGADO: e uma pergunta a quem acabou de comprar. O bot entregava e calava --
# se a chave nao ativou, quem descobria era o cliente, sozinho, e a primeira
# noticia disso chegava como reclamacao.
POSVENDA_CONFERIR=true
POSVENDA_ESPERA_HORAS=3

# Reativar quem comprou, gostou e sumiu. DESLIGADO, e a decisao e essa mesmo:
# e a UNICA coisa do bot que fala com quem nao puxou conversa, e mensagem em
# massa partindo de um numero comercial e o padrao que faz o WhatsApp derrubar
# o numero -- o que custa o atendimento inteiro, nao so a campanha.
#
# Mesmo ligado ele so fala com quem JA conversou com o bot, no maximo 5 por
# dia, uma vez a cada 120 dias, e nunca de madrugada.
POSVENDA_REATIVAR=false
POSVENDA_REATIVAR_DIAS=45
POSVENDA_REATIVAR_POR_DIA=5
POSVENDA_REATIVAR_INTERVALO_DIAS=120

# ─── Quando existe GENTE do outro lado ────────────────────
# O bot atende 24h e continua atendendo. O que muda e o que ele PROMETE: fora
# deste horario ele diz QUANDO alguem responde, em vez de "em instantes" --
# que as 3h da manha deixa o cliente acordado esperando por nada.
# Horario de Brasilia. Dias: 0 = domingo. Padrao: segunda a sabado, 9h as 21h.
ATENDENTE_INICIO_HORA=9
ATENDENTE_FIM_HORA=21
ATENDENTE_DIAS=1,2,3,4,5,6

# Teto de mensagens por cliente por hora na IA. Uma conversa normal tem ~5
# turnos; 20 numa hora e cliente preso em laco ou alguem testando em rajada.
# Estourado, ele cai no menu -- que responde na hora e nao custa nada.
LLM_MAX_POR_CLIENTE_HORA=20

# ─── Segurança dos webhooks ────────────────────────────────────────
# Token secreto que a Nerix envia como ?secret=... na URL do webhook
NERIX_WEBHOOK_SECRET=gere-um-token-aleatorio-forte

# ─── Ritmo humanizado / anti-ban (ms) ──────────────────────────────
# "Pensar" antes de digitar após receber mensagem (resposta automática)
PACING_REACTION_MIN_MS=2000
PACING_REACTION_MAX_MS=6000
# Entre mensagens consecutivas para o mesmo contato
PACING_CONSECUTIVE_MIN_MS=3000
PACING_CONSECUTIVE_MAX_MS=10000
# Entre envios para contatos diferentes (throttle global)
PACING_CROSS_MIN_MS=5000
PACING_CROSS_MAX_MS=15000
# Velocidade de digitação (letras por segundo)
PACING_CHARS_PER_SECOND=3
# Limites do tempo "digitando..."
PACING_TYPING_MIN_MS=1500
PACING_TYPING_MAX_MS=12000

# ─── Boas-vindas / primeiro contato ────────────────────────────────
# Deixe vazio para usar a saudação padrão personalizada (nome + loja).
WELCOME_MESSAGE=
# Nome da loja usado se a API da Nerix não retornar um.
STORE_NAME=
# URL do site oficial (as compras são feitas apenas pelo site).
STORE_URL=https://phazegames.com
# Horas de inatividade para tratar como nova conversa e saudar de novo.
SESSION_WINDOW_HOURS=6

# ═══════════════════════════════════════════════════════════════════
# PONTE TAOBAO — relay cliente ⇄ fornecedor na China
# ═══════════════════════════════════════════════════════════════════
# Liga a ponte. Com 'false' o bot funciona exatamente como antes.
PONTE_ATIVA=false

# copiloto  = TUDO passa por sua aprovação no WhatsApp antes de sair (comece aqui)
# autopiloto = envia sozinho, segura só o que a política marcar
PONTE_MODO=copiloto

# Seu número (só dígitos) — recebe alertas de captcha e os comandos #fila/#liberar.
# SEM ISTO o disjuntor abre e ninguém fica sabendo.
PONTE_OPERADOR_NUMERO=

# Título EXATO da conversa como aparece na lista de mensagens do app da Taobao.
# Copie caractere por caractere — é assim que o braço acha o chat certo.
PONTE_SELLER_CHAT_TITLE=
PONTE_SELLER_ID=vendedor-principal

# ─── Janela em que o fornecedor está online ────────────────────────
# ESCRITA EM HORÁRIO DE BRASÍLIA, porque vem da sua OBSERVAÇÃO e não do
# horário comercial declarado dele. Uma conversão a menos para errar.
#
# Aceita VÁRIOS intervalos separados por vírgula — ele some no meio do dia.
# Intervalo NÃO pode cruzar meia-noite; divida em dois se precisar.
# (Referência: China é 11h à nossa frente; 00:00-15:59 aqui = 11:00-02:59 lá.)
#
# Os valores abaixo saíram de 14 dias de conversa medidos (8 a 27/08): ele
# respondeu 7 vezes às 15h e 3 vezes entre 17h e 17h30, e a janela anterior
# (15:00 / 17:30) estava FECHADA nas duas pontas — o envio esperava uma pausa
# que ele não fazia. O buraco real é só das 16h às 17h.
PONTE_SELLER_TZ=America/Sao_Paulo
PONTE_SELLER_JANELAS=00:00-15:59,17:00-23:59

# ─── Responder ao outro lado sozinho ──────────────────
# Nasce DESLIGADO. E a unica parte do sistema que escreve para fora sem uma
# pessoa ter lido -- e o que a torna aceitavel e que o texto NAO e gerado: sai
# de src/ponte/repertorio.js, uma lista curta que voce escreve e aprova.
#
# Sao DUAS chaves e as duas precisam estar abertas para algo sair sem gente:
# esta, e o modo autopiloto (#auto on). No copiloto, cada resposta ainda
# espera um #ok seu.
PONTE_REPERTORIO=false

# ─── Fila serial (1 cliente por vez) ──────────────────────────────
# Sem resposta neste prazo, libera a vez para o próximo da fila.
PONTE_TIMEOUT_MIN=240
# Idas e vindas antes de você assumir (provavelmente travou).
PONTE_MAX_TURNOS=6

# ─── Limites (anti-ban da conta Taobao) ───────────────────────────
PONTE_LIM_CLIENTE_HORA=5
PONTE_LIM_VENDEDOR_HORA=10
PONTE_LIM_VENDEDOR_DIA=60
# Falhas seguidas do braço até congelar tudo sozinho.
PONTE_FALHAS_ABRIR=3

# ─── Chave que o braço Python usa nas rotas /ponte/braco/* ────────
# Gere algo aleatório: openssl rand -hex 24
PONTE_BRACO_KEY=

# ─── Proteção da margem ───────────────────────────────────────────
# 0 = NUNCA mostrar preço do fornecedor ao cliente (recomendado).
# 2.5 = converte custo CNY em preço de venda BRL automaticamente.
PONTE_MARKUP=0
PONTE_CNY_BRL=0.78

# ─── Tela remota do braço (noVNC) ──────────────────────────────────
# Quando a Taobao pede o SLIDER de verificação não existe código para
# repassar: ela mede a trajetória do arraste. Só um arraste humano passa.
# Como o navegador está dentro do container, o operador precisa de uma tela.
# Aponte um domínio do Easypanel para a porta 6080 do serviço `braco` e cole
# a URL aqui — ela vai junto no alerta de verificação.
PONTE_VNC_URL=

# ── Pedido de avaliacao no grupo (community) ──────────────────────
# ATENCAO: AVALIACAO nao e REVIEWS. COMMUNITY_REVIEWS_* sao as analises de
# JOGOS; estas aqui sao o pedido de opiniao sobre a LOJA, postado no grupo com
# imagem. Os nomes sao diferentes de proposito para nao virarem duas variaveis
# separadas por um S.
COMMUNITY_AVALIACAO_EVERY_DAYS=3
COMMUNITY_AVALIACAO_HOUR=15
# Link de avaliacao. Vazio = o post convida a responder no proprio grupo.
COMMUNITY_AVALIACAO_URL=
# Imagem fixa do post. Vazio = usa a capa de um jogo da loja.
COMMUNITY_AVALIACAO_IMAGEM=
