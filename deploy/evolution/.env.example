# Copie para ".env" (na mesma pasta) e preencha antes de subir.

# URL pública onde a Evolution ficará acessível.
# VPS:  http://SEU_IP:8080   |   com domínio:  https://evolution.seudominio.com
SERVER_URL=http://SEU_IP:8080

# Chave global de autenticação da Evolution (INVENTE uma forte, ex.: 32+ caracteres).
# Esta é a mesma que vai em EVOLUTION_API_KEY no bot.
AUTHENTICATION_API_KEY=troque-por-uma-chave-bem-forte

# Credenciais do PostgreSQL (use uma senha forte).
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=evolution
